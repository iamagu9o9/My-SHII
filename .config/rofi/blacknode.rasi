@import "colors.rasi"

* {
    font: "JetBrainsMono Nerd Font 12";
    text-color: @fg;
}

window {
    location: center;
    anchor: center;
    width: 440px;
    background-color: @bg;
    border: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    border-radius: 24px;
    padding: 18px;
}

mainbox {
    background-color: transparent;
    spacing: 12px;
    children: [inputbar, listview];
}

inputbar {
    padding: 12px 16px;
    border-radius: 14px;
    background-color: @bg-alt;
    children: [prompt, entry];
}

prompt {
    background-color: transparent;
    text-color: @fg;
    font: "JetBrainsMono Nerd Font Bold 12";
}

entry {
    background-color: transparent;
    placeholder: "BlackNode...";
    placeholder-color: @dim;
    text-color: @fg;
}

listview {
    background-color: transparent;
    lines: 8;
    columns: 1;
    fixed-height: true;
    scrollbar: false;
    spacing: 4px;
}

element {
    background-color: transparent;
    padding: 10px 14px;
    spacing: 14px;
    border-radius: 14px;
}

element normal.normal {
    background-color: transparent;
    text-color: @fg;
}

element selected.normal {
    background-color: @sel-bg;
    text-color: @sel-fg;
}

element-icon {
    background-color: transparent;
    size: 20px;
}

element-text {
    background-color: transparent;
    vertical-align: 0.5;
    text-color: inherit;
    font: "JetBrainsMono Nerd Font Medium 12";
}
