@import "colors.rasi"

* {
    font: "JetBrainsMono Nerd Font Bold 12";
    background-color: transparent;
    text-color: @fg;
}

window {
    location: center;
    anchor: center;
    width: 560px;
    background-color: @bg;
    border: 2px;
    border-color: @border-col;
    border-radius: 24px;
}

mainbox {
    padding: 16px;
    spacing: 12px;
    children: [inputbar, listview];
}

inputbar {
    padding: 12px 16px;
    spacing: 10px;
    border-radius: 18px;
    background-color: @bg-alt;
    border: 1px;
    border-color: @border-col;
    children: [prompt, entry];
}
prompt { text-color: @accent-2; }
entry {
    placeholder: "Search apps...";
    placeholder-color: @dim;
}

listview {
    lines: 7;
    columns: 1;
    fixed-height: true;
    scrollbar: false;
    spacing: 4px;
}

element {
    padding: 10px 14px;
    spacing: 12px;
    border-radius: 16px;
}
element selected.normal {
    background-color: @sel-bg;
    text-color: @sel-fg;
}
element-icon { size: 28px; }
element-text {
    vertical-align: 0.5;
    text-color: inherit;
}
